<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D"
    android:gravity="center_horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <!-- Top bar: App title + Subtitle (compact) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏍️ KoveMirror"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/header_subtitle"
            android:textColor="#7777AA"
            android:textSize="11sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1A2E"
        android:layout_marginBottom="6dp" />

    <!-- Status indicator -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_ready"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginBottom="6dp" />

    <!-- Language selector -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_language"
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginBottom="2dp" />

    <Spinner
        android:id="@+id/spLanguage"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#1A1A2E"
        android:popupBackground="#1A1A2E"
        android:layout_marginBottom="6dp" />

    <!-- Bluetooth device selector -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_select_bt_device"
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginBottom="2dp" />

    <Spinner
        android:id="@+id/spBtDevices"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#1A1A2E"
        android:popupBackground="#1A1A2E"
        android:layout_marginBottom="6dp" />

    <!-- Display Mode + Resolution side by side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_display_mode"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/spDisplayMode"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="#1A1A2E"
                android:popupBackground="#1A1A2E" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_tft_resolution"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/spTftResolution"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="#1A1A2E"
                android:popupBackground="#1A1A2E" />
        </LinearLayout>
    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1A2E"
        android:layout_marginBottom="6dp" />

    <!-- Start / Stop button -->
    <Button
        android:id="@+id/btnStartStop"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/btn_start_mirroring"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:background="#2E7D32"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <!-- Map & Route + Share Logs side by side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btnOpenMap"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/btn_open_map"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="#1565C0"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnShareLogs"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/btn_share_logs"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="#1976D2"
            android:textStyle="bold"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Debug Log Terminal -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_debug_terminal"
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginBottom="2dp" />

    <ScrollView
        android:id="@+id/svDebug"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:padding="6dp">

        <TextView
            android:id="@+id/tvDebugLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF00"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
